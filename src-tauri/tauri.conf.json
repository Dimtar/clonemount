{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clonemount",
  "version": "0.1.0",
  "identifier": "com.dimtar.clonemount",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": { "script": "node scripts/fetch-rclone.mjs", "wait": true },
    "beforeBuildCommand": "node scripts/fetch-rclone.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "clonemount",
        "width": 860,
        "height": 620,
        "minWidth": 640,
        "minHeight": 460,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/rclone"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
